{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "permission": {
    "bash": {
      "git checkout*": "deny",
      "git switch*": "deny",
      "git commit*": "deny",
      "git merge*": "deny",
